{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlogos.dev/schema/verify/1.1.0",
  "title": "openlogos verify --format json 机器契约（data 对象）",
  "x-contract-version": "1.1.0",
  "$comment": "向后兼容 superset schema：legacy verify 使用 1.0.0；含切片验证字段时使用 1.1.0。校验对象是 envelope.data。0.15.0 起 checklist / ac_trace 不再产出（verify 判定层收敛，见功能规格 §2.75），故不再必填；additionalProperties 放开，存量含该字段的响应仍合法。",
  "type": "object",
  "required": ["contract", "summary", "gate", "failed_cases", "uncovered_cases", "skipped_cases", "consistency", "pre_run", "smoke_precheck", "sandbox", "report_path"],
  "additionalProperties": true,
  "properties": {
    "contract": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": true,
      "properties": { "version": { "enum": ["1.0.0", "1.1.0"] } }
    },
    "summary": {
      "type": "object",
      "required": ["defined_count", "ut_count", "st_count", "manual_count", "executed_count", "passed_count", "failed_count", "skipped_count", "uncovered_count", "coverage_pct", "pass_rate_pct"],
      "additionalProperties": true,
      "properties": {
        "defined_count": { "type": "integer", "minimum": 0 }, "ut_count": { "type": "integer", "minimum": 0 },
        "st_count": { "type": "integer", "minimum": 0 }, "manual_count": { "type": "integer", "minimum": 0 },
        "executed_count": { "type": "integer", "minimum": 0 }, "passed_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 }, "skipped_count": { "type": "integer", "minimum": 0 },
        "uncovered_count": { "type": "integer", "minimum": 0 }, "coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "pass_rate_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "gate": {
      "type": "object", "required": ["result", "reason"], "additionalProperties": true,
      "properties": { "result": { "enum": ["PASS", "FAIL"] }, "reason": { "type": ["string", "null"] } }
    },
    "failed_cases": { "type": "array", "items": { "type": "object", "required": ["id", "error"], "properties": { "id": { "type": "string" }, "error": { "type": "string" } } } },
    "uncovered_cases": { "$ref": "#/$defs/stringArray" },
    "skipped_cases": { "$ref": "#/$defs/stringArray" },
    "consistency": { "type": "object" },
    "pre_run": { "type": "object" },
    "smoke_precheck": { "type": "object" },
    "sandbox": { "type": "object" },
    "report_path": { "type": "string" },
    "verify_mode": { "enum": ["slice-checkpoint", "final"] },
    "attempted_slice_id": { "type": ["string", "null"] },
    "eligible_test_ids": { "$ref": "#/$defs/stringArray" },
    "pending_test_ids": { "$ref": "#/$defs/stringArray" },
    "manifest": { "$ref": "#/$defs/sliceManifestSummary" },
    "checkpoint": { "$ref": "#/$defs/sliceCheckpointSummary" }
    ,"test_change_set": { "$ref": "#/$defs/testChangeSetSummary" }
    ,"scope": { "$ref": "#/$defs/verifyScope" }
    ,"rerun": {
      "$comment": "verify-flaky-rerun（功能规格 §2.108.9，spec/cli-json-output.md「verify 失败用例复跑与偶发」）：0.16.26 起恒输出；旧版输出没有该字段，消费方按「未复跑」处理。",
      "type": "object", "required": ["attempted", "skipped_reason", "max_cases", "requested_ids", "commands"], "additionalProperties": true,
      "properties": {
        "attempted": { "type": "boolean" },
        "skipped_reason": { "enum": [null, "precheck_failed", "disabled", "no_command", "gate_blocked", "no_failed_cases", "too_many_failures", "sandbox_unavailable"] },
        "max_cases": { "type": "integer", "minimum": 1 },
        "requested_ids": { "$ref": "#/$defs/stringArray" },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage", "modules", "ids", "first_exit_code", "rerun_exit_code", "skipped_reason", "status_after"],
            "additionalProperties": true,
            "properties": {
              "stage": { "enum": ["pre_run", "regression", "incremental"] },
              "modules": { "type": ["array", "null"], "items": { "type": "string" } },
              "ids": { "$ref": "#/$defs/stringArray" },
              "first_exit_code": { "type": ["integer", "null"] },
              "rerun_exit_code": { "type": ["integer", "null"] },
              "skipped_reason": { "enum": [null, "sandbox_unavailable"] },
              "status_after": { "enum": ["pass", "fail"] }
            }
          }
        }
      }
    }
    ,"flaky_cases": {
      "$comment": "verify-flaky-rerun：首跑失败、同一执行环境内复跑通过的用例；为空时不出现。",
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "module", "first_error"], "additionalProperties": true,
        "properties": { "id": { "type": "string" }, "module": { "type": ["string", "null"] }, "first_error": { "type": ["string", "null"] } }
      }
    }
    ,"level": {
      "$comment": "layered-verification（功能规格 §2.109.14，spec/cli-json-output.md「verify 分层验收与发布级验收」）：验收级别，0.16.27 起恒输出；旧版输出没有该字段，消费方按 proposal 处理。",
      "enum": ["proposal", "release"]
    }
    ,"release": {
      "$comment": "layered-verification：只在发布级验收（openlogos verify --release）输出。commit 是执行前固定的完整提交号；commit_unchanged / worktree_clean 为收尾复核结果，任一为 false 时 gate.reason 为 release_commit_changed。",
      "type": "object",
      "required": ["commit", "platform", "commit_unchanged", "worktree_clean", "head_at_finish"],
      "additionalProperties": true,
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "platform": { "type": "string", "minLength": 1 },
        "commit_unchanged": { "type": "boolean" },
        "worktree_clean": { "type": "boolean" },
        "head_at_finish": { "type": ["string", "null"] }
      }
    }
    ,"layers": {
      "$comment": "layered-verification：只在分层开启（verify.layered.enabled: true）的提案级验收输出，含执行前判 FAIL 的响应。",
      "type": "object",
      "required": ["changed", "affected", "main_path", "total", "execution", "declaration", "expansion", "outside_result_count"],
      "additionalProperties": true,
      "properties": {
        "changed": { "type": "object", "required": ["count", "ids"], "additionalProperties": true, "properties": { "count": { "type": "integer", "minimum": 0 }, "ids": { "$ref": "#/$defs/stringArray" } } },
        "affected": {
          "type": "object", "required": ["count", "ids", "scenarios"], "additionalProperties": true,
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "ids": { "$ref": "#/$defs/stringArray" },
            "scenarios": { "type": "array", "items": {
              "type": "object", "required": ["id", "sources"], "additionalProperties": true,
              "properties": {
                "id": { "type": "string", "pattern": "^S[0-9]+$" },
                "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["declared", "delta"] } }
              }
            } }
          }
        },
        "main_path": {
          "type": "object", "required": ["count", "limit", "ids", "problems", "flaky_ids"], "additionalProperties": true,
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "limit": { "type": "integer", "minimum": 1 },
            "ids": { "$ref": "#/$defs/stringArray" },
            "problems": { "type": "array", "items": {
              "type": "object", "required": ["file", "id", "code"], "additionalProperties": true,
              "properties": {
                "file": { "type": "string" },
                "id": { "type": ["string", "null"] },
                "code": { "enum": ["undefined_id", "manual_case", "not_ut_st", "duplicate_id", "duplicate_section", "item_without_id"] }
              }
            } },
            "flaky_ids": { "$ref": "#/$defs/stringArray" }
          }
        },
        "total": { "type": "object", "required": ["count", "ids"], "additionalProperties": true, "properties": { "count": { "type": "integer", "minimum": 0 }, "ids": { "$ref": "#/$defs/stringArray" } } },
        "execution": { "type": "object", "required": ["count", "ids"], "additionalProperties": true, "properties": { "count": { "type": "integer", "minimum": 0 }, "ids": { "$ref": "#/$defs/stringArray" } } },
        "declaration": {
          "type": "object", "required": ["status", "detail"], "additionalProperties": true,
          "properties": {
            "status": { "enum": ["usable", "missing", "invalid", "unknown", "scenario_unknown", "none"] },
            "detail": { "type": ["string", "null"] }
          }
        },
        "expansion": {
          "type": "object", "required": ["level", "reasons"], "additionalProperties": true,
          "properties": {
            "level": { "enum": ["none", "module", "full"] },
            "reasons": { "type": "array", "items": {
              "type": "object", "required": ["code", "detail"], "additionalProperties": true,
              "properties": {
                "code": { "enum": ["no_active_change", "base_ref_unavailable", "shared_path_changed", "shared_change_declared", "declaration_missing", "declaration_invalid", "assessment_unknown", "scenario_unknown", "module_scope_unavailable"] },
                "detail": { "type": "string" }
              }
            } }
          }
        },
        "outside_result_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "contract": { "properties": { "version": { "const": "1.0.0" } } } }, "required": ["contract"] },
      "then": { "not": { "anyOf": [
        { "required": ["verify_mode"] }, { "required": ["attempted_slice_id"] }, { "required": ["eligible_test_ids"] },
        { "required": ["pending_test_ids"] }, { "required": ["manifest"] }, { "required": ["checkpoint"] }
      ] } }
    },
    {
      "if": { "properties": { "contract": { "properties": { "version": { "const": "1.1.0" } } } }, "required": ["contract"] },
      "then": { "required": ["verify_mode", "attempted_slice_id", "eligible_test_ids", "pending_test_ids", "manifest", "checkpoint"] }
    },
    {
      "if": { "properties": { "verify_mode": { "const": "slice-checkpoint" } }, "required": ["verify_mode"] },
      "then": { "properties": { "attempted_slice_id": { "type": "string", "minLength": 1 }, "checkpoint": { "properties": { "final": { "const": false } } } } }
    },
    {
      "if": { "properties": { "verify_mode": { "const": "final" } }, "required": ["verify_mode"] },
      "then": { "properties": { "attempted_slice_id": { "type": "null" }, "pending_test_ids": { "maxItems": 0 }, "checkpoint": { "properties": { "final": { "const": true } } } } }
    }
  ],
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "verifyScope": {
      "$comment": "按模块限定 verify 范围（module-scoped-verify，功能规格 §2.96）。仅在模块范围启用（至少一个模块声明了非空 modules[].paths）或传入 --all 时输出；未启用时不输出 scope 键。",
      "type": "object",
      "required": ["mode", "modules", "reasons", "fallback_reason", "out_of_scope_result_count"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["module", "all", "fallback-full"] },
        "modules": { "$ref": "#/$defs/stringArray" },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["module", "source", "ref"],
            "additionalProperties": false,
            "properties": {
              "module": { "type": "string" },
              "source": { "enum": ["proposal", "delta", "spec", "path"] },
              "ref": { "type": "string" }
            }
          }
        },
        "fallback_reason": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["code", "detail"],
              "additionalProperties": false,
              "properties": {
                "code": { "enum": ["no_active_change", "base_ref_missing", "not_git_repository", "base_ref_unreachable", "diff_failed", "shared_config_changed", "unmapped_file", "module_paths_invalid"] },
                "detail": { "type": "string" }
              }
            }
          ]
        },
        "out_of_scope_result_count": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "fallback-full" } } },
          "then": { "properties": { "fallback_reason": { "type": "object" }, "reasons": { "maxItems": 0 }, "out_of_scope_result_count": { "const": 0 } } },
          "else": { "properties": { "fallback_reason": { "type": "null" } } }
        },
        {
          "if": { "properties": { "mode": { "const": "all" } } },
          "then": { "properties": { "reasons": { "maxItems": 0 }, "out_of_scope_result_count": { "const": 0 } } }
        }
      ]
    },
    "testChangeSetSummary": {
      "type": "object",
      "required": ["status", "schema", "sha256", "changed_test_ids", "removed_test_ids"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["valid", "invalid"] },
        "schema": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] },
        "changed_test_ids": { "$ref": "#/$defs/stringArray" },
        "removed_test_ids": { "$ref": "#/$defs/stringArray" }
      }
    },
    "sliceManifestSummary": {
      "type": "object",
      "required": ["status", "path", "schema", "task_fingerprint", "spec_fingerprint", "sha256"],
      "additionalProperties": false,
      "properties": {
        "status": { "const": "valid" }, "path": { "type": "string" }, "schema": { "type": "string" },
        "task_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "spec_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "sliceCheckpointSummary": {
      "type": "object",
      "required": ["final", "result", "confirmed_slice_ids"],
      "additionalProperties": false,
      "properties": {
        "final": { "type": "boolean" },
        "result": { "type": ["string", "null"], "enum": ["PASS", "FAIL", null] },
        "confirmed_slice_ids": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
