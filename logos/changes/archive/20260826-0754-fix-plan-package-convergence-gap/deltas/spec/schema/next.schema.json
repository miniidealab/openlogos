## MODIFIED — spec/schema/next.schema.json（整文件替换）
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlogos.dev/schema/next/1.3.0",
  "title": "openlogos next --format json 机器契约（data 对象）",
  "x-contract-version": "1.3.0",
  "$comment": "向后兼容 superset schema，最高支持契约版本 1.3.0。1.3.0 增加 Plan Package evaluation、completion issues；next 额外增加 dispatch completion。JSON Schema dialect = draft 2020-12；校验对象 = envelope 的 data 字段；additionalProperties 保持放开，未知值由消费方保守处理。",
  "type": "object",
  "required": [
    "contract"
  ],
  "additionalProperties": true,
  "properties": {
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nextModule"
      }
    },
    "next_node": {
      "$ref": "#/$defs/nextNode"
    },
    "proposal_step": {
      "$ref": "#/$defs/proposalStepOrNull"
    },
    "loop_state": {
      "$ref": "#/$defs/loopState"
    },
    "slice_state": {
      "$ref": "#/$defs/sliceState"
    },
    "slice_verification_state": {
      "$ref": "#/$defs/sliceVerificationState"
    },
    "auto": {
      "type": "boolean"
    },
    "gate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "skippable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "gate_auto_passed": {
      "type": "boolean"
    },
    "auto_execute": {
      "type": "boolean"
    },
    "plan_state": {
      "$ref": "#/$defs/planState"
    },
    "plan_package": {
      "$ref": "#/$defs/planPackage"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "contract"
        ],
        "properties": {
          "contract": {
            "properties": {
              "version": {
                "const": "1.0.0"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "modules": {
            "items": {
              "not": {
                "required": [
                  "features"
                ]
              }
            }
          }
        }
      },
      "$comment": "条件版本（add-feature-model delta-F1=B）：contract.version==1.0.0 ⟹ 任何 module 都不得含 features；features 存在即强制 version 为 1.1.0，pre-feature 响应逐字节保持 1.0.0"
    },
    {
      "if": {
        "required": [
          "contract"
        ],
        "properties": {
          "contract": {
            "properties": {
              "version": {
                "enum": [
                  "1.0.0",
                  "1.1.0"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "plan_state": {
            "not": {
              "required": [
                "clarification"
              ]
            }
          },
          "modules": {
            "items": {
              "properties": {
                "plan_state": {
                  "not": {
                    "required": [
                      "clarification"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "$comment": "契约 1.0.0/1.1.0 不得输出 clarification；出现任一 clarification 必须声明 1.2.0。"
    }
  ],
  "$defs": {
    "contract": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": true,
      "properties": {
        "version": {
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0",
            "1.3.0"
          ],
          "$comment": "1.0.0 为基础契约；1.1.0 支持 feature；1.2.0 支持 clarification；1.3.0 支持 Plan Package evaluation 与 completion issues。"
        }
      }
    },
    "proposalStep": {
      "enum": [
        "writing",
        "ready-to-delta",
        "delta-writing",
        "ready-to-merge",
        "merge-generated",
        "spec-complete-required",
        "test-id-required",
        "ready-to-implement",
        "coding",
        "ready-to-verify",
        "verify-passed",
        "verify-failed",
        "ready-to-deploy",
        "deploy-done",
        "ready-to-smoke",
        "smoke-passed",
        "smoke-failed",
        "implementing",
        "in-progress"
      ]
    },
    "proposalStepOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/proposalStep"
        },
        {
          "type": "null"
        }
      ]
    },
    "dispatch": {
      "type": "object",
      "required": [
        "idempotent",
        "timeout_seconds",
        "artifacts_hint"
      ],
      "additionalProperties": true,
      "properties": {
        "idempotent": {
          "type": "boolean",
          "$comment": "重派发是否安全；权威声明来自 flow 节点定义，driver 不得本地 allowlist 猜测"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "$comment": "resolved 物化值；未显式声明的节点取 flow 顶层 defaults.dispatch.timeout_seconds（唯一默认值源 fallback）"
        },
        "artifacts_hint": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "$comment": "[] = 「产物未知」契约语义：消费方不得据此判死，只能升级观察"
        },
        "completion": {
          "$ref": "#/$defs/completionExpectation"
        }
      }
    },
    "nextNode": {
      "type": "object",
      "required": [
        "id",
        "name",
        "subflow_id",
        "skill",
        "working_agent",
        "review_agent",
        "pre_script",
        "post_script",
        "dispatch"
      ],
      "$comment": "八字段锚的可执行化：next_node 一旦出现，id/name/subflow_id 与五个固定 hint（skill/working_agent/review_agent/pre_script/post_script，无绑定必须显式 null）恒在场，加本契约新增的恒存在 dispatch；requires_reviewed 仅声明节点输出。modules[].next_node 与 legacy 顶层 next_node 复用本定义。",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "subflow_id": {
          "type": "string"
        },
        "skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "working_agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "pre_script": {
          "type": [
            "string",
            "null"
          ]
        },
        "post_script": {
          "type": [
            "string",
            "null"
          ]
        },
        "gate_id": {
          "type": "string"
        },
        "slice": {
          "type": "string"
        },
        "slice_children": {
          "type": "array"
        },
        "dispatch": {
          "$ref": "#/$defs/dispatch"
        },
        "requires_reviewed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "$comment": "可选；仅节点显式声明时输出（如内置 launched apply-merge = [\"proposal\",\"delta\"]）；未声明节点不含本字段"
        }
      }
    },
    "stepMeta": {
      "type": "object",
      "required": [
        "phase",
        "kind"
      ],
      "additionalProperties": true,
      "properties": {
        "phase": {
          "enum": [
            "pre-implement",
            "implement",
            "post-implement"
          ]
        },
        "kind": {
          "enum": [
            "produce",
            "gate",
            "command-required",
            "residency"
          ]
        }
      }
    },
    "facts": {
      "type": "object",
      "required": [
        "spec_complete",
        "slices_planned",
        "slices_approved",
        "code_required",
        "has_delta_tasks",
        "verify_pass"
      ],
      "additionalProperties": true,
      "properties": {
        "spec_complete": {
          "type": "boolean"
        },
        "slices_planned": {
          "type": "boolean"
        },
        "slices_approved": {
          "type": "boolean"
        },
        "code_required": {
          "type": "boolean"
        },
        "has_delta_tasks": {
          "type": "boolean"
        },
        "verify_pass": {
          "type": "boolean"
        }
      }
    },
    "activeChange": {
      "type": "object",
      "required": [
        "slug",
        "proposal_step",
        "step_meta",
        "facts"
      ],
      "additionalProperties": true,
      "properties": {
        "slug": {
          "type": "string"
        },
        "proposal_step": {
          "$ref": "#/$defs/proposalStep"
        },
        "step_meta": {
          "$ref": "#/$defs/stepMeta"
        },
        "facts": {
          "$ref": "#/$defs/facts"
        }
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "id",
        "name",
        "spec",
        "scenarios"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^F(?:0[1-9]|[1-9]\\d+)$"
            },
            {
              "const": "__ungrouped__"
            }
          ],
          "$comment": "规范编号 F01…F09/F10…F99/F100+（^F(?:0[1-9]|[1-9]\\d+)$，项目全局唯一，拒 F00/F0/F001 等前导零）或保留伪 feature id \"__ungrouped__\"（恒排末位）"
        },
        "name": {
          "type": "string"
        },
        "spec": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "feature-specs 文档序号，无链接为 null；required（键恒在场）"
        },
        "scenarios": {
          "type": "array",
          "$comment": "稳定场景成员列表（与 phase/生命周期无关）",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      },
      "$comment": "add-feature-model：feature 功能分组（透传自 status）。可选、minor 新增。已注册空成员 feature 保留输出 scenarios:[]。省略当且仅当 module 既无注册 feature 且无场景带 feature 键；有注册 feature 或有场景带 feature 键（含未知/跨 module 悬空引用的 __ungrouped__ 降级桶）即输出"
    },
    "loopState": {
      "type": "object",
      "required": [
        "subflow_id",
        "until",
        "max_iters",
        "iteration",
        "converged",
        "escalated"
      ],
      "additionalProperties": true,
      "properties": {
        "subflow_id": {
          "type": "string"
        },
        "until": {
          "enum": [
            "tests_green",
            "code_slices_green"
          ]
        },
        "max_iters": {
          "type": "integer",
          "minimum": 1
        },
        "iteration": {
          "type": "integer",
          "minimum": 0
        },
        "converged": {
          "type": "boolean"
        },
        "escalated": {
          "type": "boolean"
        },
        "activated_at": {
          "type": "string",
          "format": "date-time"
        },
        "exhausted_skippable": {
          "type": "boolean"
        }
      }
    },
    "sliceState": {
      "type": "object",
      "required": [
        "total",
        "done",
        "remaining"
      ],
      "additionalProperties": true,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "remaining": {
          "type": "integer",
          "minimum": 0
        },
        "current": {
          "type": "string"
        }
      }
    },
    "nextModule": {
      "type": "object",
      "required": [
        "id",
        "active_change",
        "proposal_step"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposal_step": {
          "$ref": "#/$defs/proposalStepOrNull"
        },
        "active_change": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "next 的 active_change 是提案 slug 字符串（status 才是对象）；step_meta/facts/code_required 在 next 平铺于 module 级（既有 S28/expose-code-required 契约）；required 基础字段（可为 null）——漏字段不再绕过条件校验"
        },
        "next_node": {
          "$ref": "#/$defs/nextNode"
        },
        "loop_state": {
          "$ref": "#/$defs/loopState"
        },
        "slice_state": {
          "$ref": "#/$defs/sliceState"
        },
        "slice_verification_state": {
          "$ref": "#/$defs/sliceVerificationState"
        },
        "code_required": {
          "type": "boolean"
        },
        "facts": {
          "$ref": "#/$defs/facts"
        },
        "step_meta": {
          "$ref": "#/$defs/stepMeta"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          },
          "$comment": "add-feature-model：透传 status 的 feature 分组（1.1.0 minor 新增）。省略当且仅当 module 无注册 feature 且无场景带 feature 键；否则输出（含 __ungrouped__ 降级桶）"
        },
        "plan_state": {
          "$ref": "#/$defs/planState"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "active_change": {
                "type": "string"
              }
            },
            "required": [
              "active_change"
            ]
          },
          "then": {
            "required": [
              "active_change",
              "proposal_step",
              "step_meta",
              "facts",
              "code_required"
            ],
            "$comment": "活跃提案模块（active_change 为 slug 字符串）必须携带步骤自描述与权威事实（code review F3：可执行契约必须能拒绝「步骤在场但自描述缺失」漂移）"
          }
        },
        {
          "if": {
            "properties": {
              "proposal_step": {
                "type": "string"
              }
            },
            "required": [
              "proposal_step"
            ]
          },
          "then": {
            "required": [
              "active_change",
              "proposal_step",
              "step_meta",
              "facts",
              "code_required"
            ],
            "$comment": "code review r2-F3：proposal_step 非 null 同样强制完整自描述——缺 active_change 不再构成绕过"
          }
        }
      ]
    },
    "sliceVerificationState": {
      "type": "object",
      "required": [
        "manifest_status",
        "verify_mode",
        "attempted_slice_id",
        "confirmed_slice_ids",
        "eligible_test_ids",
        "pending_test_ids",
        "manifest",
        "checkpoint"
      ],
      "additionalProperties": true,
      "properties": {
        "manifest_status": {
          "enum": [
            "valid",
            "missing",
            "invalid",
            "stale",
            "unsupported"
          ]
        },
        "verify_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "slice-checkpoint",
            "final",
            null
          ]
        },
        "attempted_slice_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed_slice_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "eligible_test_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "pending_test_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "reason": {
          "type": "string"
        },
        "human_action_required": {
          "type": "boolean"
        },
        "test_change_set": {
          "$ref": "#/$defs/testChangeSetSummary"
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sliceViolation"
          }
        },
        "manifest": {
          "$ref": "#/$defs/sliceManifestSummary"
        },
        "checkpoint": {
          "$ref": "#/$defs/sliceCheckpointSummary"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verify_mode": {
                "const": "slice-checkpoint"
              }
            },
            "required": [
              "verify_mode"
            ]
          },
          "then": {
            "properties": {
              "attempted_slice_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verify_mode": {
                "const": "final"
              }
            },
            "required": [
              "verify_mode"
            ]
          },
          "then": {
            "properties": {
              "attempted_slice_id": {
                "type": "null"
              },
              "pending_test_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "testChangeSetSummary": {
      "type": "object",
      "required": [
        "status",
        "schema",
        "sha256",
        "changed_test_ids",
        "removed_test_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "changed_test_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "removed_test_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "sliceViolation": {
      "type": "object",
      "required": [
        "code",
        "path",
        "message",
        "fix_hint"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "fix_hint": {
          "type": "string"
        }
      }
    },
    "sliceManifestSummary": {
      "type": "object",
      "required": [
        "status",
        "path",
        "schema",
        "task_fingerprint",
        "spec_fingerprint",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "valid",
            "missing",
            "invalid",
            "stale",
            "unsupported"
          ]
        },
        "path": {
          "type": "string"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "spec_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sliceCheckpointSummary": {
      "type": "object",
      "required": [
        "final",
        "result",
        "confirmed_slice_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "final": {
          "type": "boolean"
        },
        "result": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "PASS",
            "FAIL",
            null
          ]
        },
        "confirmed_slice_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "clarificationOption": {
      "type": "object",
      "required": [
        "id",
        "label",
        "tradeoff"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "tradeoff": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "clarificationNextDecision": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "id",
            "category",
            "question",
            "impact",
            "recommendation",
            "recommendation_reason",
            "options"
          ],
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^C(?:0[1-9]|[1-9]\\d+)$"
            },
            "category": {
              "enum": [
                "product",
                "ownership",
                "data",
                "compatibility",
                "security_privacy",
                "deployment",
                "release",
                "external_commitment",
                "acceptance"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "impact": {
              "type": "string",
              "minLength": 1
            },
            "recommendation": {
              "type": "string",
              "minLength": 1
            },
            "recommendation_reason": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/clarificationOption"
              }
            }
          }
        }
      ]
    },
    "clarification": {
      "type": "object",
      "required": [
        "schema",
        "mode",
        "status",
        "required",
        "required_categories",
        "unresolved_decisions",
        "next_decision_id",
        "reason",
        "next_decision"
      ],
      "additionalProperties": true,
      "properties": {
        "schema": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^openlogos/clarification@[1-9]\\d*$",
          "$comment": "proposal 中实际检测到的 schema；unknown 主版本在 invalid/upgrade 分支原样输出，legacy missing 可为 null"
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "complete/pending 分支收紧为 adaptive/deep/provided；invalid 可为 null 或检测原值"
        },
        "status": {
          "enum": [
            "pending",
            "complete",
            "invalid"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "required_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "product",
              "ownership",
              "data",
              "compatibility",
              "security_privacy",
              "deployment",
              "release",
              "external_commitment",
              "acceptance"
            ]
          },
          "maxItems": 9,
          "$comment": "只列尚未满足类别；complete/invalid 为空。固定顺序由共享 builder 与负向测试保证。"
        },
        "unresolved_decisions": {
          "type": "integer",
          "minimum": 0
        },
        "next_decision_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^C(?:0[1-9]|[1-9]\\d+)$"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_decision": {
          "$ref": "#/$defs/clarificationNextDecision"
        }
      },
      "$comment": "oneOf 约束 complete/pending/invalid 跨字段组合。next_decision_id 与 next_decision.id 相等、required_categories 固定顺序无法用标准 Draft 2020-12 完整表达，由 status/next 共用 builder 与负向契约测试保证。",
      "oneOf": [
        {
          "title": "complete",
          "properties": {
            "schema": {
              "const": "openlogos/clarification@1"
            },
            "mode": {
              "enum": [
                "adaptive",
                "deep",
                "provided"
              ]
            },
            "status": {
              "const": "complete"
            },
            "required": {
              "const": false
            },
            "required_categories": {
              "type": "array",
              "maxItems": 0
            },
            "unresolved_decisions": {
              "const": 0
            },
            "next_decision_id": {
              "type": "null"
            },
            "reason": {
              "type": "null"
            },
            "next_decision": {
              "type": "null"
            }
          }
        },
        {
          "title": "pending-recoverable",
          "properties": {
            "schema": {
              "const": "openlogos/clarification@1"
            },
            "mode": {
              "enum": [
                "adaptive",
                "deep",
                "provided"
              ]
            },
            "status": {
              "const": "pending"
            },
            "required": {
              "const": true
            },
            "required_categories": {
              "type": "array",
              "minItems": 1,
              "maxItems": 9
            },
            "unresolved_decisions": {
              "type": "integer",
              "minimum": 1
            },
            "next_decision_id": {
              "type": "string",
              "pattern": "^C(?:0[1-9]|[1-9]\\d+)$"
            },
            "reason": {
              "enum": [
                "high-impact-user-decision-required",
                "data-clarification-required",
                "compatibility-clarification-required",
                "security-privacy-clarification-required",
                "deployment-clarification-required",
                "release-clarification-required",
                "external-commitment-clarification-required"
              ]
            },
            "next_decision": {
              "allOf": [
                {
                  "$ref": "#/$defs/clarificationNextDecision"
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "$comment": "合法 pending 必须可恢复并携带完整当前问题；类别专属 reason 与队首 category 的一致性、ID 相等由共享 builder 测试保证。"
        },
        {
          "title": "invalid-normalized",
          "properties": {
            "status": {
              "const": "invalid"
            },
            "required": {
              "const": true
            },
            "required_categories": {
              "type": "array",
              "maxItems": 0
            },
            "unresolved_decisions": {
              "const": 0
            },
            "next_decision_id": {
              "type": "null"
            },
            "reason": {
              "enum": [
                "clarification-contract-invalid",
                "clarification-upgrade-required",
                "legacy-clarification-backfill-required"
              ]
            },
            "next_decision": {
              "type": "null"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "reason": {
                    "const": "clarification-upgrade-required"
                  }
                },
                "required": [
                  "reason"
                ]
              },
              "then": {
                "properties": {
                  "schema": {
                    "type": "string",
                    "pattern": "^openlogos/clarification@[1-9]\\d*$",
                    "not": {
                      "const": "openlogos/clarification@1"
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "reason": {
                    "const": "legacy-clarification-backfill-required"
                  }
                },
                "required": [
                  "reason"
                ]
              },
              "then": {
                "properties": {
                  "schema": {
                    "type": "null"
                  },
                  "mode": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "schema": {
                    "type": "string",
                    "pattern": "^openlogos/clarification@[1-9]\\d*$",
                    "not": {
                      "const": "openlogos/clarification@1"
                    }
                  }
                },
                "required": [
                  "schema"
                ]
              },
              "then": {
                "properties": {
                  "reason": {
                    "const": "clarification-upgrade-required"
                  }
                }
              }
            }
          ],
          "$comment": "invalid 归一化为零未决/null next；未知主版本在 schema 字段原样输出且不得伪装 @1。"
        }
      ]
    },
    "planState": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "plan_ready": {
          "type": "boolean"
        },
        "clarification": {
          "$ref": "#/$defs/clarification"
        },
        "plan_package": {
          "$ref": "#/$defs/planPackage"
        },
        "completion_contract_version": {
          "type": "string",
          "minLength": 1
        },
        "completion_issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/completionIssue"
          }
        },
        "proposal_filled": {
          "type": "boolean"
        },
        "tasks_plan_filled": {
          "type": "boolean"
        },
        "tasks_code_required": {
          "type": "boolean"
        },
        "tasks_code_slices_filled": {
          "type": "boolean"
        }
      }
    },
    "completionIssue": {
      "type": "object",
      "required": [
        "code",
        "path",
        "message",
        "fix_hint"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "actual": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "fix_hint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "planPackage": {
      "type": "object",
      "required": [
        "schema",
        "contract_version",
        "ready",
        "proposal",
        "tasks",
        "issues"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "openlogos/plan-package-evaluation@1"
        },
        "contract_version": {
          "type": "string",
          "minLength": 1
        },
        "ready": {
          "type": "boolean"
        },
        "proposal": {
          "type": "object",
          "required": [
            "filled",
            "issues"
          ],
          "additionalProperties": false,
          "properties": {
            "filled": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/completionIssue"
              }
            }
          }
        },
        "tasks": {
          "type": "object",
          "required": [
            "plan_filled",
            "code_required",
            "code_slices_filled",
            "issues"
          ],
          "additionalProperties": false,
          "properties": {
            "plan_filled": {
              "type": "boolean"
            },
            "code_required": {
              "type": "boolean"
            },
            "code_slices_filled": {
              "type": "boolean"
            },
            "issues": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/completionIssue"
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/completionIssue"
          }
        }
      }
    },
    "completionExpectation": {
      "type": "object",
      "required": [
        "command",
        "expected",
        "expected_proposal_step"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "boolean",
              "string",
              "number",
              "null"
            ]
          }
        },
        "expected_proposal_step": {
          "$ref": "#/$defs/proposalStep"
        }
      }
    }
  }
}

